# Base URL of the FastAPI backend, including the /api/v1 prefix.
#
# Two supported configurations. Both work now that the backend registers CORS
# for the dev origins (app/main.py -> CORSMiddleware).
#
# 1. Direct to the backend (default below). The browser calls the API cross
#    origin from :5173 to :8000. Requires the backend CORS allowlist to include
#    this origin, which it does for localhost:5173 / 127.0.0.1:5173.
VITE_API_URL=http://localhost:8000/api/v1

# 2. Through the Vite dev reverse proxy (see vite.config.ts). Set the value
#    below instead of the one above to make every request same-origin, which
#    removes the CORS round-trip entirely and is the closer match to how the app
#    is served in production.
# VITE_API_URL=/api/v1

# Dev-only mock mode (optional, opt-in). When "true", the app replays static
# fixtures instead of calling the backend, so the UI can be iterated on without
# waiting 20-45s per real answer. Never enable this for a real build.
# VITE_MOCK_API=true
