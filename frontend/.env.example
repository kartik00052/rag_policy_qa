# Base URL of the FastAPI backend, including the /api/v1 prefix.
# Local dev: the backend is started with backend\scripts\start_server.ps1
VITE_API_URL=http://localhost:8000/api/v1

# Dev-only mock mode (optional, opt-in). When "true", the app replays static
# fixtures instead of calling the backend, so the UI can be iterated on without
# waiting 20-45s per real answer. Never enable this for a real build.
# VITE_MOCK_API=true
