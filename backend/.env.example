# Copy to backend/.env and fill in. Never commit .env itself.
APP_NAME=RAG Policy
ENVIRONMENT=development

# PROJECT.md Section 15. Must use an async driver (psycopg, not the default).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_policy

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Set explicitly - do not hardcode a model name in application code.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Collection holding dense + sparse chunk vectors.
QDRANT_COLLECTION=policy_chunks

# Raw uploads land here (PROJECT.md Section 2: local disk, not S3/MinIO).
# Relative to the backend/ working directory.
STORAGE_DIR=storage

# Uvicorn auto-reload for local development. Must be false to run the backend
# the supported way: backend\scripts\start_server.ps1 refuses to start when this
# is anything but false, because V1 runs ingestion inside the API process, so a
# reload triggered by a code edit cancels the in-flight task.
RELOAD=false

# LLM Provider configuration (Stage 10): groq (default) | gemini | ollama (local fallback)
LLM_PROVIDER=groq

# Groq cloud configuration (default, high speed LPU inference)
# Model options: llama-3.3-70b-versatile (128k ctx), llama-3.1-8b-instant (128k ctx)
# Free-tier rate limits for 70b: 30 RPM, 12k TPM, 1k RPD, 100k TPD
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini cloud configuration (secondary)
# Model options: gemini-2.0-flash, gemini-1.5-flash
# Free-tier rate limits: 15 RPM, 1M TPM, 1.5k RPD
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama local configuration (offline / private fallback)
# Model must be pulled locally: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

