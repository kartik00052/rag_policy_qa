# Copy to backend/.env and fill in. Never commit .env itself.
APP_NAME=RAG Policy
ENVIRONMENT=development

# PROJECT.md Section 15. Must use an async driver (psycopg, not the default).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_policy

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Set explicitly - do not hardcode a model name in application code.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Collection holding dense + sparse chunk vectors.
QDRANT_COLLECTION=policy_chunks

# Raw uploads land here (PROJECT.md Section 2: local disk, not S3/MinIO).
# Relative to the backend/ working directory.
STORAGE_DIR=storage

# Uvicorn auto-reload for local development. Must be false to run the backend
# the supported way: backend\scripts\start_server.ps1 refuses to start when this
# is anything but false, because V1 runs ingestion inside the API process, so a
# reload triggered by a code edit cancels the in-flight task.
RELOAD=false

# Used from Stage 5 onward; provider is chosen at deploy time, not in code.
# Leaving LLM_PROVIDER empty means answer generation fails at request time with a
# provider error, so set it before trying /api/v1/chat/stream.
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=ollama. Ollama serves these on 11434; the model
# must be pulled locally (ollama pull qwen2.5:3b) or generation returns a
# model-not-found error at request time.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
