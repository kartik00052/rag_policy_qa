  "cards": [
    { "dot": "cyan", "title": "Retrieval", "items": ["Dense (bge-small) and sparse BM25 run in parallel", "RRF fuses both lists, cross-encoder reranks to top-k"] },
    { "dot": "rose", "title": "Guardrails", "items": ["Evidence gate refuses when support is too low", "Every citation must match a real matched_text span"] },
    { "dot": "amber", "title": "Streaming contract", "items": ["Validate-then-replay: raw tokens are never trusted", "A refusal emits done only — no token events"] }
