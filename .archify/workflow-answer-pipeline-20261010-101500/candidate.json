  "nodes": [
    { "id": "question", "lane": "client", "col": 0, "type": "external", "label": "User question", "sublabel": "plain language", "width": 140 },
    { "id": "answer", "lane": "client", "col": 5, "type": "frontend", "label": "Cited answer", "sublabel": "streamed via SSE", "width": 150, "sources": [{ "path": "frontend/src/lib/sse.ts" }] },
    { "id": "endpoint", "lane": "api", "col": 1, "type": "backend", "label": "POST /chat/stream", "sublabel": "SSE endpoint", "width": 150, "sources": [{ "path": "backend/app/api/chat.py" }] },
    { "id": "dense", "lane": "retrieve", "col": 2, "type": "database", "label": "Dense search", "sublabel": "Qdrant semantic", "width": 150, "yOffset": -40, "sources": [{ "path": "backend/app/services/retrieval.py" }] },
    { "id": "sparse", "lane": "retrieve", "col": 2, "type": "database", "label": "Sparse BM25", "sublabel": "Qdrant lexical", "width": 150, "yOffset": 40, "sources": [{ "path": "backend/app/services/bm25.py" }] },
    { "id": "fusion", "lane": "retrieve", "col": 3, "type": "backend", "label": "RRF fusion + rerank", "sublabel": "cross-encoder top-k", "width": 176, "sources": [{ "path": "backend/app/services/reranker.py" }] },
    { "id": "gate", "lane": "guard", "col": 4, "type": "security", "label": "Evidence gate", "sublabel": "top score ≥ threshold", "width": 160, "sources": [{ "path": "backend/app/services/evidence.py" }] },
    { "id": "llm", "lane": "generate", "col": 5, "type": "backend", "label": "LLM generates", "sublabel": "grounded + cited", "width": 150, "sources": [{ "path": "backend/app/services/llm.py" }] },
    { "id": "refusal", "lane": "outcome", "col": 3, "type": "security", "label": "Honest refusal", "sublabel": "not found — no guess", "width": 150 }
  ],
  "edges": [
    { "id": "e-ask", "from": "question", "to": "endpoint", "label": "asks", "variant": "emphasis" },
    { "id": "e-dense", "from": "endpoint", "to": "dense", "label": "semantic", "variant": "default" },
    { "id": "e-sparse", "from": "endpoint", "to": "sparse", "label": "lexical", "variant": "default", "role": "branch" },
    { "id": "e-fuse-d", "from": "dense", "to": "fusion", "variant": "default" },
    { "id": "e-fuse-s", "from": "sparse", "to": "fusion", "variant": "default" },
    { "id": "e-gate", "from": "fusion", "to": "gate", "label": "reranked score", "variant": "emphasis" },
    { "id": "e-gen", "from": "gate", "to": "llm", "label": "sufficient", "variant": "emphasis" },
    { "id": "e-refuse", "from": "gate", "to": "refusal", "label": "insufficient", "variant": "security", "role": "error" },
    { "id": "e-stream", "from": "llm", "to": "answer", "label": "stream tokens + citations", "variant": "emphasis" }
